[Unit]
Description=FBIF publishing P0 monitoring watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/var/www/api/publish.env
ExecStart=/usr/bin/python3 /opt/fbif-monitor-watchdog/watchdog.py --state /var/lib/fbif-monitor-watchdog/state.json
TimeoutStartSec=90s
StateDirectory=fbif-monitor-watchdog
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
