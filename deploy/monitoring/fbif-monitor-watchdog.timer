[Unit]
Description=Run FBIF publishing P0 monitoring watchdog every two minutes

[Timer]
OnBootSec=45s
# 部署会在长时间运行的主机上重新启用 timer；此时 OnBootSec 已经过期，
# OnActiveSec 保证每次 enable/start 都会产生一个未来触发点。
OnActiveSec=2min
OnUnitActiveSec=2min
AccuracySec=15s
RandomizedDelaySec=10s
Persistent=true
Unit=fbif-monitor-watchdog.service

[Install]
WantedBy=timers.target
