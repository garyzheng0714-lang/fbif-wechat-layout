# fbifmp-layout.foodtalks.cn — 排版工具站点 Caddy vhost（声明式，架构体检 S4）
#
# 本文件是该站点路由的唯一真相源：仓库改这里 → 部署 rsync 到
# /etc/caddy/sites/fbifmp-layout.caddy → caddy validate 通过才 reload。
# 服务器主 Caddyfile（15 个站点共用）只保留一行 `import sites/fbifmp-layout.caddy`，
# 本项目部署不再对主文件做注入式 patch（旧脚本曾因此连修 6 次路由）。
#
# /api 全部交给 Go 9001，未知 API 由 Go 统一返回 JSON 404，
# 绝不落到 SPA 静态 fallback 形成 HTML 假 200。
# 9000 的旧 Python 程序只留给 Go 本机转存图片，不对公网（2026-11-09 安全审计摘掉
# /api/wechat-draft、/api/oss-presign：它只看 Origin/Referer，能被伪造）。

fbifmp-layout.foodtalks.cn {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@fbifAppShell path / /index.html /app.html /distribute.html /version.json
	header @fbifAppShell Cache-Control "no-cache"

	@fbifVersionedAssets {
		path /js/* /css/*
		query v=*
	}
	header @fbifVersionedAssets >Cache-Control "public, max-age=31536000, immutable"

	@fbifVendorAssets path /vendor/*
	header @fbifVendorAssets >Cache-Control "public, max-age=31536000, immutable"

	@fbifImageAssets path *.png *.jpg *.jpeg *.webp *.gif *.svg *.ico
	header @fbifImageAssets >Cache-Control "public, max-age=86400"

	@fbifChannels path /mp /mp/* /ft /ft/*
	handle @fbifChannels {
		reverse_proxy localhost:9001
	}

	# 发布流水线（M4-M7）：审核预览页 + 任务管理 API + 飞书卡片回调。
	# FEISHU_CALLBACK_MODE=websocket 时 API 对公网 Webhook 精确返回 404；只有显式
	# webhook 模式才开放该 POST 端点，两种传输层不再同时可用。
	@fbifPublish path /preview/*
	handle @fbifPublish {
		reverse_proxy localhost:9001
	}

	encode gzip zstd

	# 登录走 FBIF 统一登录（api/auth_login.go）：去登录中心、回调、飞书登录与授权、退出都在 Go。
	# 登录健康检查只给本机看（在服务器上 curl 127.0.0.1:9001/internal/auth/health）；
	# 叫醒接口 /internal/auth/*-changed 是中台和集成平台从外网调的，照常放行。
	# 两个 handle 互不重叠（handle 比 respond 先跑，单写 respond 挡不住）。
	@fbifLoginHealth path /internal/auth/health
	handle @fbifLoginHealth {
		respond 404
	}

	@fbifAuth {
		path /auth/login /auth/center/* /auth/feishu/* /auth/feishu-grant /internal/auth/*
		not path /internal/auth/health
	}
	handle @fbifAuth {
		reverse_proxy localhost:9001
	}

	@fbifAPI path /api /api/*
	handle @fbifAPI {
		reverse_proxy localhost:9001 {
			transport http {
				read_timeout 180s
				write_timeout 180s
			}
		}
	}

	handle {
		root * /var/www/wechat-layout
		try_files {path} /index.html
		@static path *.css *.js
		header @static Cache-Control "no-cache"
		file_server
	}
}
