# FBIF 中台下发给 fbif-api 的变量：服务器上的 /etc/fbif-hub/env/layout.env，由中台本机代理整份写（root:root 0600），
# 人和部署脚本不写。systemd drop-in zz-fbif-hub.conf 让 fbif-api 最后读它、同名为准；CI 和 publish.env 不再放这些值。
# 换值在内部工具服务器上 hubctl put <编号>，详见 FBIF-One-Api 的 docs/hub/公共变量和密钥.md。
CLOUDCONVERT_API_KEY=<set-by-fbif-hub>
FEISHU_LOGIN_APP_SECRET=<set-by-fbif-hub>
PUBLISH_ADMIN_SERVICE_TOKEN=<set-by-fbif-hub>
RENDER_TOKEN=<set-by-fbif-hub>
DISTRIBUTION_API_TOKEN=<set-by-fbif-hub>
FEISHU_APP_SECRET=<set-by-fbif-hub>
FOODTALKS_TOKEN=<set-by-fbif-hub>
HUB_KEY=<set-by-fbif-hub>
PUBLISH_SYNC_SERVICE_TOKEN=<set-by-fbif-hub>
TIKHUB_API_KEY=<set-by-fbif-hub>
# 本人飞书授权（api/internal/feishugrant）封存令牌的钥匙：沿用原来登录模板那把，换了已授权的人都要重新授权。
SSO_TOKEN_KEY=<set-by-fbif-hub>
