# 由部署流水线生成；正式值仅来自 GitHub Secrets。
ENV=production
FBIF_CONFIG_SCHEMA_VERSION=1
ADMIN_PASSWORD=<set-in-secret-store>
PUBLIC_DIR=/var/www/wechat-layout
WECHAT_UPLOAD_ORIGIN=https://fbifmp-layout.foodtalks.cn
RENDER_TOKEN=<set-in-secret-store>
RENDER_SERVICE_URL=http://127.0.0.1:19096
DEPLOYMENT_WRITES_PAUSED=1
LIBREOFFICE_URL=
LIBREOFFICE_TOKEN=
CLOUDCONVERT_API_KEY=
