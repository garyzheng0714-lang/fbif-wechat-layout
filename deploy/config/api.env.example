# 由部署流水线生成；正式值仅来自 GitHub Secrets。
ENV=production
FBIF_CONFIG_SCHEMA_VERSION=1
PUBLISH_ADMIN_SERVICE_TOKEN=<set-in-secret-store>
RULE_SUPER_ADMIN_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_SESSION_SECRET=<at-least-24-random-bytes>
AUTH_USERS_PATH=/var/www/api/data/auth-users.json
AUTH_PASSWORD_USERS_B64=<base64-json-account-list>
FEISHU_LOGIN_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_LOGIN_APP_SECRET=<set-in-secret-store>
FEISHU_LOGIN_REDIRECT_URI=https://fbifmp-layout.foodtalks.cn/auth/feishu/fbif/callback
FEISHU_LOGIN_SCOPES=
PUBLIC_DIR=/var/www/wechat-layout
WECHAT_UPLOAD_ORIGIN=https://fbifmp-layout.foodtalks.cn
WECHAT_UPLOAD_ENDPOINT=http://127.0.0.1:9000/api/wechat-upload
RENDER_TOKEN=<set-in-secret-store>
RENDER_SERVICE_URL=http://127.0.0.1:19096
DEPLOYMENT_WRITES_PAUSED=1
LIBREOFFICE_URL=
LIBREOFFICE_TOKEN=
CLOUDCONVERT_API_KEY=
