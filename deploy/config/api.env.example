# 由部署流水线生成；正式值仅来自 GitHub Secrets。
# CLOUDCONVERT_API_KEY、FEISHU_LOGIN_APP_SECRET、PUBLISH_ADMIN_SERVICE_TOKEN、RENDER_TOKEN、SSO_TOKEN_KEY
# 由 FBIF 中台下发到 /etc/fbif-hub/env/layout.env（见 hub-layout.env.example），不写在这里。
ENV=production
FBIF_CONFIG_SCHEMA_VERSION=1
RULE_SUPER_ADMIN_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_SESSION_SECRET=<at-least-24-random-bytes>
AUTH_USERS_PATH=/var/www/api/data/auth-users.json
# 登录由入口统一拦截（deploy/caddy/fbifmp-layout.caddy），本项目没有登录变量。
# 本人授权飞书（读云文档、列群）回到这里；要在飞书开放平台本应用的「重定向 URL」里登记。
FEISHU_LOGIN_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_LOGIN_REDIRECT_URI=https://fbifmp-layout.foodtalks.cn/auth/feishu/fbif/qr-callback
FEISHU_LOGIN_SCOPES=
PUBLIC_DIR=/var/www/wechat-layout
WECHAT_UPLOAD_ORIGIN=https://fbifmp-layout.foodtalks.cn
WECHAT_UPLOAD_ENDPOINT=http://127.0.0.1:9000/api/wechat-upload
RENDER_SERVICE_URL=http://127.0.0.1:19096
# 排版接口 v1 用的排版程序（同一份 render-service 代码的另一个进程）；不填就是这个默认值
LAYOUT_RENDER_URL=http://127.0.0.1:19098
# 排版接口成品里可以原样留的 FBIF 自己图床（两个 OSS 桶、FoodTalks 图床，逗号分隔，整张替换）；不填就是这个默认值
LAYOUT_IMAGE_HOSTS=fbif-gary-img-hz.oss-cn-hangzhou.aliyuncs.com,fbif-feishu-base.oss-cn-shanghai.aliyuncs.com,static.foodtalks.cn
DEPLOYMENT_WRITES_PAUSED=1
LIBREOFFICE_URL=
LIBREOFFICE_TOKEN=
