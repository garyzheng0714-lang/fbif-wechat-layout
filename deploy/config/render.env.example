# 由部署流水线生成到 /var/www/render-service.env。
# RENDER_TOKEN 由 FBIF 中台下发到 /etc/fbif-hub/env/render.env（见 hub-render.env.example），不写在这里。
FBIF_CONFIG_SCHEMA_VERSION=1
NODE_ENV=production
RENDER_PORT=19096
PUBLIC_DIR=/var/www/wechat-layout
RULES_API_ORIGIN=http://127.0.0.1:9001
ASSET_ORIGIN=https://fbifmp-layout.foodtalks.cn
RENDER_BUILD_SHA=<git-commit-sha>
