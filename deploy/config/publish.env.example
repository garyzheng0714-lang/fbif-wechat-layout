# 服务器受保护的 /var/www/api/publish.env；不要把真实值提交到仓库。
PUBLISH_SYNC_SERVICE_TOKEN=<set-in-secret-store>
PUBLISH_HTTP_REVIEW_ENABLED=0
PUBLISH_HTTP_REVIEWER_OPEN_ID=
RULES_STORE_PATH=/var/www/api/data/rule-presets.json
PUBLISH_JOBS_PATH=/var/www/api/data/publish-jobs.json
PUBLISH_DELIVERY_SETTINGS_PATH=/var/www/api/data/publish-delivery.json
EXPENSIVE_API_TOKEN=
FOODTALKS_BASE_URL=https://api-we-test.foodtalks.cn
FOODTALKS_TOKEN=<set-in-secret-store>
FOODTALKS_ORIGIN=
FOODTALKS_FRONT_URL=https://test.foodtalks.cn
FOODTALKS_ADMIN_ARTICLE_URL=https://admin-we-test.foodtalks.cn/#/
FOODTALKS_CATEGORY_IDS=52,58
FOODTALKS_EXPECTED_TARGET=test
SITE_OWN_ACCOUNTS=
FEISHU_APP_ID=<set-in-secret-store>
FEISHU_APP_SECRET=<set-in-secret-store>
# 可选：JSON 数组，配置多个可发送审核卡的飞书应用；为空时使用上面的默认应用。
FEISHU_NOTIFICATION_APPS_JSON=
FEISHU_REVIEW_CHAT_ID=<set-in-secret-store>
PUBLISH_MONITOR_FEISHU_USER_ID=<set-in-secret-store>
FEISHU_CALLBACK_MODE=websocket
FEISHU_VERIFICATION_TOKEN=
FEISHU_REVIEWER_OPEN_IDS=<set-in-secret-store>
ARK_API_KEY=<set-in-secret-store>
ARK_MODEL_ID=
ARK_MODEL_ID_B=<set-model-endpoint-id>
ARK_JUDGE_MODEL_ID=<set-model-endpoint-id>
ARK_BASE_URL=https://ark.cn-beijing.volces.com
LAYOUT_MONITOR_URL=https://fbifmp-layout.foodtalks.cn/api/publish/monitoring
FEED_MONITOR_URL=https://feed.foodtalks.cn/health/sync
OFFICIAL_MONITOR_URL=http://112.124.103.65:3002/api/wechat/official/monitoring
