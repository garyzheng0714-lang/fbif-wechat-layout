# 服务器受保护的 /var/www/api/publish.env；不要把真实值提交到仓库。
# DISTRIBUTION_API_TOKEN、FEISHU_APP_SECRET、FOODTALKS_TOKEN、HUB_KEY、PUBLISH_SYNC_SERVICE_TOKEN、TIKHUB_API_KEY
# 由 FBIF 中台下发到 /etc/fbif-hub/env/layout.env（见 hub-layout.env.example），不写在这里。
# 排版查转载原文时问 Feed 订阅列表；与 Feed 共用同步令牌 PUBLISH_SYNC_SERVICE_TOKEN。
# 任务状态推给 Feed（status_callback_url）也只许指向这个源，签名同样用那把同步令牌。
FOODTALKS_FEED_BASE_URL=https://feed.foodtalks.cn
# 可选。Feed 未订该号、公众号又没填「阅读原文」时，用 TikHub 广域搜（搜一搜）按标题补微信链接。
# 国内机器默认 https://api.tikhub.dev；旧 REDFOX_* 不再读取，留在服务器上也不影响校验。
TIKHUB_API_BASE_URL=https://api.tikhub.dev
# 可选。非公众号网页直抓拿不到正文（站点反爬）时改用 Jina Reader；国内直连 r.jina.ai 被墙，
# 填 socks5 出站代理（与 Feed 的 JINA_OUTBOUND_PROXY 同一出口）。留空即直连。
JINA_OUTBOUND_PROXY=
PUBLISH_HTTP_REVIEW_ENABLED=0
PUBLISH_HTTP_REVIEWER_OPEN_ID=
RULES_STORE_PATH=/var/www/api/data/rule-presets.json
PUBLISH_JOBS_PATH=/var/www/api/data/publish-jobs.json
PUBLISH_DELIVERY_SETTINGS_PATH=/var/www/api/data/publish-delivery.json
PUBLISH_REPOST_SOURCES_PATH=/var/www/api/data/publish-repost-sources.json
EXPENSIVE_API_TOKEN=
FOODTALKS_BASE_URL=https://api-we-test.foodtalks.cn
FOODTALKS_ORIGIN=https://admin-we-test.foodtalks.cn
FOODTALKS_FRONT_URL=https://test.foodtalks.cn
FOODTALKS_ADMIN_ARTICLE_URL=https://admin-we-test.foodtalks.cn/#/
FOODTALKS_CATEGORY_IDS=52,58
FOODTALKS_REPOST_CATEGORY_IDS=53
FOODTALKS_EXPECTED_TARGET=test
SITE_OWN_ACCOUNTS=
# 自己的分发服务（FBIF-多平台分发工具，在 B 机）：平台限制经它读，头条号、百家号经它存草稿。A 机经 SSH 通道在本机访问。
DISTRIBUTION_API_URL=http://127.0.0.1:18095
# FBIF 中台（One-Api 第二实例，在 B 机）：外发账号（多维表格「平台账号」）从它的配置包读。A 机经 SSH 通道在本机访问。
HUB_BUNDLE_URL=http://127.0.0.1:13199/api/config/bundle/layout
FEISHU_APP_ID=<set-in-secret-store>
# 可选：JSON 数组，配置多个可发送审核卡的飞书应用；为空时使用上面的默认应用。
FEISHU_NOTIFICATION_APPS_JSON=
FEISHU_REVIEW_CHAT_ID=<set-in-secret-store>
PUBLISH_MONITOR_FEISHU_USER_ID=<set-in-secret-store>
FEISHU_CALLBACK_MODE=websocket
FEISHU_VERIFICATION_TOKEN=
FEISHU_REVIEWER_OPEN_IDS=<set-in-secret-store>
# 群成员审核模式（2026-08-06 用户裁定）：开启后，来自 FEISHU_REVIEW_CHAT_ID 群内的
# 卡片操作即有审核权限；白名单继续兼容。
FEISHU_REVIEWER_ALLOW_CHAT_MEMBERS=1
# AI 预填与风险检查（2026-10-07 用户裁定）：看图与翻译等批量任务用 Flash，
# 风险检查等高价值任务用 Pro。模型名留空即用代码默认 mimo-v2.6-pro / mimo-v2.6-flash。
# 密钥和地址从中台密钥端点取（配了 HUB_BUNDLE_URL 就只用中台的，api/hub_secrets.go），这两行生产留空；
# 只有没接中台的本机开发才填。
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_PRO_MODEL=
MIMO_FLASH_MODEL=
# 旧豆包/DeepSeek 配置：本服务已不读取，仅为旧 publish.env 兼容保留；新环境保持为空。
ARK_API_KEY=
ARK_MODEL_ID=
ARK_MODEL_ID_B=
ARK_JUDGE_MODEL_ID=
ARK_BASE_URL=
# 仅为旧 publish.env 兼容保留；本服务不读取这些键、不主动外检。
# 旧值若仍存在由部署秘密配置管理；新环境保持为空。
LAYOUT_MONITOR_URL=
FEED_MONITOR_URL=
OFFICIAL_MONITOR_URL=
