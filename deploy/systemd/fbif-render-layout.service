[Unit]
Description=FBIF layout API renderer (POST /layout for /api/layout/v1)
Wants=network-online.target
After=network-online.target fbif-api.service fbif-render.service
# 和 fbif-render 同一份代码（/var/www/render-service）、同一把 RENDER_TOKEN：fbif-render 重启（部署、
# FBIF 中台的本机代理换 RENDER_TOKEN 后重启它）时这里跟着重启，中台那边不用另登记这个进程。
PartOf=fbif-render.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/var/www/render-service
Environment=FBIF_CONFIG_SCHEMA_VERSION=1
Environment=LAYOUT_PORT=19098
# PUBLIC_DIR、RULES_API_ORIGIN、ASSET_ORIGIN、RENDER_BUILD_SHA 与 fbif-render 同一份；
# 中台文件放最后（同名为准），和 fbif-render 的 drop-in zz-fbif-hub.conf 读到的是同一个文件。
EnvironmentFile=/var/www/render-service.env
EnvironmentFile=/etc/fbif-hub/env/render.env
ExecStart=/usr/bin/node /var/www/render-service/layout-server.mjs
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
