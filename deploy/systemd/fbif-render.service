[Unit]
Description=FBIF headless render service
Wants=network-online.target
After=network-online.target fbif-api.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/var/www/render-service
Environment=FBIF_CONFIG_SCHEMA_VERSION=1
EnvironmentFile=/var/www/render-service.env
ExecStart=/usr/bin/node /var/www/render-service/server.mjs
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
