{
  "name": "fbif-wechat-layout",
  "version": "1.0.1",
  "description": "FBIF 微信公众号排版工具 — DOCX/Markdown 转微信 HTML",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='public/js/**/*.js' --test-coverage-include='render-service/**/*.mjs' --test-coverage-lines=35 --test-coverage-branches=60 --test-coverage-functions=40 --test tests/*.test.mjs",
    "lint:js": "node tools/check-js-quality.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "test:e2e": "playwright test",
    "test:e2e:ci": "E2E_SKIP_VISUAL=1 playwright test",
    "test:e2e:baseline": "E2E_UPDATE_BASELINE=1 playwright test --update-snapshots",
    "gen:registry": "cd api && go run . -emit-registry > ../public/js/rule-packs/registry.js",
    "gen:blocks": "cd api && go run . -emit-blocks > ../public/js/blocks/block-registry.gen.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "linkedom": "^0.18.12"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.1"
  }
}
