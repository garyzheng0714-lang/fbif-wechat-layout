{
 "behavior": {
  "lists": {
   "image_caption_keywords": [
    "图片来源",
    "资料来源",
    "数据来源",
    "图源",
    "来源",
    "制图",
    "截图",
    "图注",
    "注：",
    "Source",
    "Photo",
    "Image",
    "Credit"
   ]
  },
  "params": {
   "biz_coop_replace_regex": {
    "default": "^\\s*商务合作对接请点击",
    "type": "string"
   },
   "contact_field_regex": {
    "default": "^(地址|地點|地点|官网|官網|网址|網址|网站|網站|电话|電話|联系电话|联系方式|邮箱|郵箱|邮件|手机|手機|微信|公众号|公眾號|传真|傳真|Tel|Phone|Email|E-?mail|Add|Address|Web|Website)\\s*[：:]",
    "type": "string"
   },
   "contact_section_regex": {
    "default": "联系",
    "type": "string"
   },
   "content_start_signal": {
    "default": "firstImage",
    "type": "string"
   },
   "credit_line_regex": {
    "default": "^(本文来源|来源|出处|出品|作者|撰文|撰稿|文|编辑|责编|责任编辑|微信编辑|新媒体编辑|编者|审核|审校|复核|校对|翻译|编译|采访|设计|视觉|整理|统筹|策划)\\s*[：:｜|]\\s*\\S",
    "type": "string"
   },
   "english_font_size": {
    "default": 14,
    "type": "number"
   },
   "footer_note_regex": {
    "default": "^本文(?:未标注来源图片/数据均来自|作者\\s*[：:]|图片来源)|图片均来自",
    "type": "string"
   },
   "front_matter_scan_limit": {
    "default": 25,
    "type": "number"
   },
   "level1_regex": {
    "default": "^[一二三四五六七八九十百零]+\\s*[、.．]\\s*",
    "type": "string"
   },
   "level2_regex": {
    "default": "^[（(]\\s*[一二三四五六七八九十百零]+\\s*[)）]",
    "type": "string"
   },
   "own_source_regex": {
    "default": "(?i)^foodtalks",
    "type": "string"
   },
   "recommended_reading_regex": {
    "default": "^\\s*(相关阅读|推荐阅读)\\s*[：:]\\s*$",
    "type": "string"
   },
   "ref_item_regex": {
    "default": "^\\s*\\[\\d+\\]",
    "type": "string"
   },
   "ref_section_regex": {
    "default": "^(参考(来源|文献|资料|链接)|信息来源)\\s*[：:]?\\s*$",
    "type": "string"
   },
   "site_article_layout": {
    "default": true,
    "type": "boolean"
   },
   "site_byline_regex": {
    "default": "^本文为(.{1,40}?)原创",
    "type": "string"
   },
   "site_footer_start_regex": {
    "default": "^(提示\\s*[：:]\\s*$|[*＊]\\s*资讯投稿与商务合作|加入微信群\\s*$|关注公众号\\s*$|点击获取更多全球食品资讯)",
    "type": "string"
   },
   "site_tip_source_regex": {
    "default": "^[*＊]?\\s*本文为(.{1,40}?)原创(?:《(.{1,120}?)》)?",
    "type": "string"
   },
   "tip_item_regex": {
    "default": "^\\s*[*＊·]",
    "type": "string"
   },
   "tip_label_regex": {
    "default": "^提示\\s*[：:]\\s*$",
    "type": "string"
   },
   "toc_marker_regex": {
    "default": "^目录\\s*$",
    "type": "string"
   }
  },
  "templates": {
   "biz_coop_replacement": "如有合作意向，请移至“{contact_section}”获取联系方式",
   "contact_tip": "*FoodTalks资讯投稿与商务合作，请联系Bobo。",
   "original_tip": "*本文为FoodTalks原创，转载请底部留言。",
   "recommended_reading_note": "查看更多推荐阅读，请拉至文末点击“阅读原文”访问FoodTalks网站",
   "ref_header_label": "参考来源：",
   "repost_tip": "*本文为{source}原创{author}，转载请联系出处。{original_title}",
   "source_credit": "来源：{source}{source_id}"
  }
 },
