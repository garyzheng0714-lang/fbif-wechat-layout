  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "顶部工具栏的唯一主动作，适用于复制、保存等边界明确的任务。",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">复制全文</button>",
      "css": ".ds-btn-primary{height:36px;padding:0 18px;border:0;border-radius:var(--fs-r-s,6px);background:var(--fs-brand,#1456F0);color:#fff;font-family:var(--fs-font,'PingFang SC',sans-serif);font-size:14px;font-weight:600;cursor:pointer;transition:background var(--fs-t-fast,150ms) var(--fs-ease-out,ease),transform var(--fs-t-fast,150ms) var(--fs-ease-out,ease)}.ds-btn-primary:hover{background:var(--fs-brand-hover,#0F4DD1)}.ds-btn-primary:focus-visible{outline:0;box-shadow:0 0 0 2px var(--fs-brand-soft,#EBF1FF),0 0 0 3px var(--fs-brand,#1456F0)}.ds-btn-primary:active{background:var(--fs-brand-active,#0B3FBA);transform:scale(.96)}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}.ds-btn-primary:active{transform:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "用于规则、取消和次要工具动作，保持冷白且不与主按钮竞争。",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">规则</button>",
      "css": ".ds-btn-secondary{height:36px;padding:0 14px;border:0;border-radius:var(--fs-r-s,6px);background:var(--fs-bg-card,#fff);color:var(--fs-text-1,#1F2329);box-shadow:inset 0 0 0 1px var(--fs-border-control,#D9DCE0);font-family:var(--fs-font,'PingFang SC',sans-serif);font-size:14px;font-weight:500;cursor:pointer;transition:background var(--fs-t-fast,150ms) var(--fs-ease-out,ease),box-shadow var(--fs-t-fast,150ms) var(--fs-ease-out,ease)}.ds-btn-secondary:hover{background:var(--fs-bg-hover,rgba(31,35,39,.045));box-shadow:inset 0 0 0 1px var(--fs-text-3,#6F757D)}.ds-btn-secondary:focus-visible{outline:0;box-shadow:0 0 0 2px var(--fs-brand-soft,#EBF1FF),0 0 0 3px var(--fs-brand,#1456F0)}.ds-btn-secondary:active{background:var(--fs-bg-press,rgba(31,35,39,.08))}"
    },
    {
      "name": "Input Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "紧凑的文本输入，弱文字仍满足白底可读性要求。",
      "html": "<label class=\"ds-field-label\" for=\"ds-field\">正文 / 链接</label><input class=\"ds-field\" id=\"ds-field\" placeholder=\"粘贴公众号链接或正文\">",
      "css": ".ds-field-label{display:block;margin-bottom:6px;color:var(--fs-text-2,#646A73);font-family:var(--fs-font,'PingFang SC',sans-serif);font-size:12px;font-weight:600}.ds-field{box-sizing:border-box;width:100%;height:34px;padding:0 10px;border:0;border-radius:var(--fs-r-s,6px);background:var(--fs-bg-card,#fff);color:var(--fs-text-1,#1F2329);box-shadow:inset 0 0 0 1px var(--fs-border-control,#D9DCE0);font-family:var(--fs-font,'PingFang SC',sans-serif);font-size:13px;transition:box-shadow var(--fs-t-fast,150ms) var(--fs-ease-out,ease)}.ds-field::placeholder{color:var(--fs-text-3,#6F757D)}.ds-field:focus{outline:0;box-shadow:inset 0 0 0 1px var(--fs-brand,#1456F0),0 0 0 3px var(--fs-brand-soft,#EBF1FF)}"
    },
    {
      "name": "Account Trigger",
      "kind": "nav",
      "refersTo": "account-trigger",
      "description": "统一账号菜单的单层触发器，以账号而非渠道控件作为切换对象。",
      "html": "<button class=\"ds-account-trigger\" type=\"button\" aria-expanded=\"false\"><span class=\"ds-account-avatar\">微</span><span>FBIF食品饮料创新</span><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>",
      "css": ".ds-account-trigger{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 10px;border:0;border-radius:var(--fs-r-s,6px);background:transparent;color:var(--fs-text-1,#1F2329);font-family:var(--fs-font,'PingFang SC',sans-serif);font-size:14px;font-weight:500;cursor:pointer;transition:background var(--fs-t-fast,150ms) var(--fs-ease-out,ease)}.ds-account-trigger:hover,.ds-account-trigger[aria-expanded=true]{background:var(--fs-bg-sunken,#F2F3F5)}.ds-account-trigger:focus-visible{outline:0;box-shadow:0 0 0 2px var(--fs-brand-soft,#EBF1FF)}.ds-account-avatar{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:var(--fs-r-s,6px);background:#08A128;color:#fff;font-size:12px;font-weight:700}.ds-account-trigger svg{color:var(--fs-text-3,#6F757D)}"
    },
    {
      "name": "Import Card",
      "kind": "card",
      "refersTo": "compact-card",
      "description": "把文件拖放与正文输入组合成一个紧凑、可扫描的导入入口。",
      "html": "<section class=\"ds-import-card\"><strong>导入内容</strong><button class=\"ds-dropzone\" type=\"button\">粘贴或拖拽至这里上传</button><textarea class=\"ds-import-text\" placeholder=\"粘贴公众号链接、正文或 Markdown\"></textarea></section>",
      "css": ".ds-import-card{display:flex;flex-direction:column;gap:10px;padding:12px;border:1px solid var(--fs-border-card,#E5E6EB);border-radius:var(--fs-r-m,8px);background:var(--fs-bg-card,#fff);color:var(--fs-text-1,#1F2329);font-family:var(--fs-font,'PingFang SC',sans-serif);font-size:14px}.ds-dropzone{min-height:76px;border:1px dashed var(--fs-border-control,#D9DCE0);border-radius:var(--fs-r-s,6px);background:#FAFAFA;color:var(--fs-text-2,#646A73);font:inherit;cursor:pointer;transition:border-color var(--fs-t-mid,200ms) var(--fs-ease-out,ease),background var(--fs-t-mid,200ms) var(--fs-ease-out,ease)}.ds-dropzone:hover{border-color:var(--fs-brand,#1456F0);background:var(--fs-brand-soft,#EBF1FF)}.ds-dropzone:focus-visible{outline:0;box-shadow:0 0 0 2px var(--fs-brand-soft,#EBF1FF)}.ds-import-text{min-height:72px;padding:9px 10px;border:0;border-radius:var(--fs-r-s,6px);box-shadow:inset 0 0 0 1px var(--fs-border-control,#D9DCE0);color:var(--fs-text-1,#1F2329);font:13px/1.6 var(--fs-font,'PingFang SC',sans-serif);resize:vertical}.ds-import-text::placeholder{color:var(--fs-text-3,#6F757D)}.ds-import-text:focus{outline:0;box-shadow:inset 0 0 0 1px var(--fs-brand,#1456F0),0 0 0 2px var(--fs-brand-soft,#EBF1FF)}"
    },
    {
      "name": "Toggle Switch",
      "kind": "custom",
      "refersTo": "toggle-switch",
      "description": "用于明确的二元模块开关，状态同时由位置、颜色和 aria-checked 表达。",
      "html": "<button class=\"ds-switch\" type=\"button\" role=\"switch\" aria-checked=\"true\" aria-label=\"显示底部区块\"><span></span></button>",
      "css": ".ds-switch{position:relative;width:36px;height:20px;padding:0;border:0;border-radius:9999px;background:var(--fs-brand,#1456F0);box-shadow:inset 0 0 0 1px var(--fs-brand,#1456F0);cursor:pointer;transition:background var(--fs-t-fast,150ms) var(--fs-ease-out,ease)}.ds-switch span{position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:var(--fs-sh-s1,0 1px 3px rgba(31,35,39,.04));transform:translateX(16px);transition:transform var(--fs-t-fast,150ms) var(--fs-ease-out,ease)}.ds-switch[aria-checked=false]{background:var(--fs-bg-sunken,#F2F3F5);box-shadow:inset 0 0 0 1px var(--fs-border-control,#D9DCE0)}.ds-switch[aria-checked=false] span{transform:none}.ds-switch:focus-visible{outline:0;box-shadow:0 0 0 2px var(--fs-brand-soft,#EBF1FF),inset 0 0 0 1px var(--fs-brand,#1456F0)}@media(prefers-reduced-motion:reduce){.ds-switch,.ds-switch span{transition:none}}"
    },
    {
      "name": "Result Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "只确认已完成结果，不承载需要用户决策的信息。",
      "html": "<div class=\"ds-toast\" role=\"status\"><span aria-hidden=\"true\">✓</span>已复制到剪贴板</div>",
      "css": ".ds-toast{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:var(--fs-r-m,8px);background:var(--fs-text-1,#1F2329);color:#fff;box-shadow:var(--fs-sh-s3,0 12px 32px rgba(31,35,39,.12));font-family:var(--fs-font,'PingFang SC',sans-serif);font-size:13px;font-weight:500}.ds-toast span{color:#41D693;font-size:16px}"
    },
    {
      "name": "Modal",
      "kind": "custom",
      "refersTo": "modal",
      "description": "仅用于必须中断当前上下文的选择或裁剪任务，内联能完成时不使用。",
      "html": "<section class=\"ds-modal\" role=\"dialog\" aria-labelledby=\"ds-modal-title\"><header><strong id=\"ds-modal-title\">替换图片</strong><button type=\"button\" aria-label=\"关闭\">×</button></header><div class=\"ds-modal-body\">从当前卡片媒体库选择图片。</div><footer><button class=\"ds-modal-action\" type=\"button\">确认</button></footer></section>",
      "css": ".ds-modal{width:min(520px,100%);overflow:hidden;border:0;border-radius:var(--fs-r-l,10px);background:var(--fs-bg-card,#fff);color:var(--fs-text-1,#1F2329);box-shadow:var(--fs-sh-s3,0 12px 32px rgba(31,35,39,.12));font-family:var(--fs-font,'PingFang SC',sans-serif)}.ds-modal header,.ds-modal footer{display:flex;align-items:center;padding:14px 18px}.ds-modal header{border-bottom:1px solid var(--fs-divider,rgba(31,35,39,.08))}.ds-modal header strong{flex:1;font-size:15px}.ds-modal header button{width:30px;height:30px;border:0;border-radius:var(--fs-r-s,6px);background:transparent;color:var(--fs-text-2,#646A73);font-size:20px;cursor:pointer}.ds-modal header button:hover{background:var(--fs-bg-sunken,#F2F3F5)}.ds-modal-body{padding:18px;color:var(--fs-text-2,#646A73);font-size:13px}.ds-modal footer{justify-content:flex-end;border-top:1px solid var(--fs-divider,rgba(31,35,39,.08))}.ds-modal-action{height:34px;padding:0 14px;border:0;border-radius:var(--fs-r-s,6px);background:var(--fs-brand,#1456F0);color:#fff;font:600 13px var(--fs-font,'PingFang SC',sans-serif);cursor:pointer}.ds-modal-action:focus-visible,.ds-modal header button:focus-visible{outline:0;box-shadow:0 0 0 2px var(--fs-brand-soft,#EBF1FF)}"
    },
    {
      "name": "WeChat Preview Surface",
      "kind": "custom",
      "refersTo": "wechat-preview",
      "description": "直接在纯白页面流动的微信公众号内容契约，无 phone-frame 外观。",
      "html": "<article class=\"ds-wx-preview\"><h1>文章标题左对齐</h1><p class=\"ds-wx-meta\">FBIF食品饮料创新　2026年7月13日</p><p>正文以真实发布后的可读节奏呈现，外壳样式不会进入这里。</p><p class=\"ds-wx-author\">作者：FBIF编辑部</p></article>",
